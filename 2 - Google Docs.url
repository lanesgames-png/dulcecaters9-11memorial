body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0f172a;
  color: white;
}

header {
  text-align: center;
  padding: 20px;
  background: #020617;
}

.games {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  padding: 20px;
}

.game-card {
  background: #020617;
  border-radius: 10px;
  padding: 10px;
}

.game-card h2 {
  text-align: center;
}

iframe {
  width: 100%;
  height: 400px;
  border: none;
  border-radius: 10px;
}

footer {
  text-align: center;
  padding: 10px;
  background: #020617;
}
